rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid == userId &&
        data.role == 'owner' &&
        data.email is string && data.email.size() > 0 && data.email.size() < 100;
    }
    function isValidPortfolio(data) {
      return data.keys().hasAll(['userId', 'title', 'validationStatus']) &&
        data.userId is string &&
        data.validationStatus in ['pending', 'validated', 'rejected'];
    }
    function isValidWorkplaceReport(data) {
      return data.keys().hasAll(['userId', 'role', 'status']) &&
        data.userId is string &&
        data.role in ['specialist', 'apprentice'] &&
        data.status in ['draft', 'submitted', 'validated'];
    }

    // Firestore rules cannot redact fields from a document. Keep user profiles
    // private; use a separately curated publicProfiles collection for discovery.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Admin roles must be provisioned by a trusted administrative process.
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'emergencyContact', 'address',
          'specialization', 'specializationBrand', 'isAvailable',
          'unavailableDates', 'yearsOfExperience', 'certifications',
          'affiliations', 'accreditations', 'accomplishments', 'bio',
          'photoURL', 'dob', 'idNumber', 'isProfileComplete',
          'trainingPath', 'apprenticeStartAge', 'apprenticeStatus',
          'mentorId', 'offersMentorship', 'latitude', 'longitude'
        ])
      );
      allow delete: if isAdmin();
    }

    // Vehicle records contain ownership evidence, identifiers and service history.
    // Technician access should be introduced via an explicit assignment model.
    match /vehicles/{vehicleId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() &&
        isOwner(request.resource.data.ownerId) &&
        request.resource.data.ownerId is string;
      allow update: if isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /vehicleLogs/{logId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() &&
        (isOwner(request.resource.data.ownerId) || isAdmin()) &&
        request.resource.data.ownerId is string;
      allow update: if isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /serviceRequests/{requestId} {
      function isParticipant(data) {
        return isAuthenticated() && (
          data.ownerId == request.auth.uid ||
          data.specialistId == request.auth.uid ||
          data.apprenticeId == request.auth.uid
        );
      }
      allow read: if isParticipant(resource.data) || isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId is string;
      // Participants cannot transfer ownership, vehicles or assigned roles.
      allow update: if (isParticipant(resource.data) || isAdmin()) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.vehicleId == resource.data.vehicleId &&
        (isAdmin() ||
          (request.resource.data.specialistId == resource.data.specialistId &&
           request.resource.data.apprenticeId == resource.data.apprenticeId));
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /workplaceReports/{reportId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() &&
        isOwner(request.resource.data.userId) &&
        isValidWorkplaceReport(request.resource.data);
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        resource.data.status == 'draft' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == 'draft'
      );
      allow delete: if isAdmin();
    }

    match /portfolios/{portfolioId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() &&
        isOwner(request.resource.data.userId) &&
        isValidPortfolio(request.resource.data);
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.validationStatus == resource.data.validationStatus
      );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /regionalStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny for collections without an explicit rule above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
