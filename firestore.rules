rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, role, specialization, experience, bio, photoURL, isVerified, rating, flagged
    //
    // Collection: vehicles
    // Fields: ownerId, make, model, year, vin, mileage, serviceHistory, faults
    //
    // Collection: serviceRequests
    // Fields: ownerId, vehicleId, specialistId, apprenticeId, type, status, description, callOutFee, diagnosticQuote, partsQuote, totalAmount, paymentStatus, createdAt, checklist
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "yellowbeasttech@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRole(role) {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.role in ['owner', 'specialist', 'apprentice', 'admin'] &&
             data.email is string && data.email.size() < 100;
    }

    function isValidPortfolio(data) {
      return data.keys().hasAll(['userId', 'title', 'validationStatus']) &&
             data.userId is string &&
             data.validationStatus in ['pending', 'validated', 'rejected'];
    }

    function isValidWorkplaceReport(data) {
      return data.keys().hasAll(['userId', 'role', 'status']) &&
             data.userId is string &&
             data.role in ['specialist', 'apprentice'] &&
             data.status in ['draft', 'submitted', 'validated'];
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.ownerId) || hasRole('specialist') || hasRole('apprentice'));
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update: if isAuthenticated() && (isOwner(resource.data.ownerId) || hasRole('specialist') || hasRole('apprentice'));
    }

    match /vehicleLogs/{logId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.ownerId) || hasRole('specialist') || hasRole('apprentice'));
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update: if isAuthenticated() && (isOwner(resource.data.ownerId) || hasRole('specialist') || hasRole('apprentice'));
    }

    match /serviceRequests/{requestId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.ownerId) || isOwner(resource.data.specialistId) || isOwner(resource.data.apprenticeId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update: if isAuthenticated() && (isOwner(resource.data.ownerId) || isOwner(resource.data.specialistId) || isOwner(resource.data.apprenticeId) || isAdmin());
    }

    match /workplaceReports/{reportId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || hasRole('specialist') || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && isValidWorkplaceReport(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || hasRole('specialist') || isAdmin());
    }

    match /portfolios/{portfolioId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || hasRole('specialist') || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && isValidPortfolio(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || hasRole('specialist') || isAdmin());
    }

    match /regionalStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
