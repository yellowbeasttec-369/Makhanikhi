rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid == userId &&
        data.role in ['owner', 'specialist', 'apprentice'] &&
        data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
        (!('isVerified' in data) || data.isVerified == false) &&
        (!('verificationStatus' in data) || data.verificationStatus == 'pending') &&
        (!('rating' in data) || data.rating == 0);
    }
    function isValidPortfolio(data) {
      return data.keys().hasAll(['userId', 'title', 'validationStatus']) &&
        data.userId is string &&
        data.validationStatus in ['pending', 'validated', 'rejected'];
    }
    function isValidWorkplaceReport(data) {
      return data.keys().hasAll(['userId', 'role', 'status']) &&
        data.userId is string &&
        data.role in ['specialist', 'apprentice'] &&
        data.status in ['draft', 'submitted', 'validated'];
    }

    // Firestore rules cannot redact fields from a document. Keep user profiles
    // private; use a separately curated publicProfiles collection for discovery.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Self-registration is permitted for ordinary roles, never for admin.
      // New accounts cannot self-verify or create a reviewed/approved status.
      allow create: if isOwner(userId) &&
        isValidUser(request.resource.data, userId) &&
        (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role in ['owner', 'specialist', 'apprentice'] &&
        (request.resource.data.role == resource.data.role || !('isProfileComplete' in resource.data) || resource.data.isProfileComplete != true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'displayName', 'phone', 'emergencyContact', 'address',
          'specialization', 'specializationBrand', 'isAvailable',
          'unavailableDates', 'yearsOfExperience', 'certifications',
          'affiliations', 'accreditations', 'accomplishments', 'bio',
          'photoURL', 'dob', 'idNumber', 'isProfileComplete',
          'trainingPath', 'apprenticeStartAge', 'apprenticeStatus',
          'mentorId', 'offersMentorship', 'latitude', 'longitude',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Vehicle records contain ownership evidence, identifiers and service history.
    // Technician access should be introduced via an explicit assignment model.
    match /vehicles/{vehicleId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() &&
        isOwner(request.resource.data.ownerId) &&
        request.resource.data.ownerId is string;
      allow update: if isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /vehicleLogs/{logId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() &&
        (isOwner(request.resource.data.ownerId) || isAdmin()) &&
        request.resource.data.ownerId is string;
      allow update: if isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /serviceRequests/{requestId} {
      function isParticipant(data) {
        return isAuthenticated() && (
          data.ownerId == request.auth.uid ||
          data.specialistId == request.auth.uid ||
          data.apprenticeId == request.auth.uid
        );
      }
      allow read: if isParticipant(resource.data) || isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId is string &&
        (!('specialistId' in request.resource.data) || request.resource.data.specialistId == null) &&
        (!('apprenticeId' in request.resource.data) || request.resource.data.apprenticeId == null);
      // Participants cannot transfer ownership, vehicles or assigned roles.
      allow update: if (isParticipant(resource.data) || isAdmin()) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.vehicleId == resource.data.vehicleId &&
        (isAdmin() ||
          (request.resource.data.specialistId == resource.data.specialistId &&
           request.resource.data.apprenticeId == resource.data.apprenticeId));
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /workplaceReports/{reportId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() &&
        isOwner(request.resource.data.userId) &&
        isValidWorkplaceReport(request.resource.data) &&
        request.resource.data.status == 'draft';
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        resource.data.status == 'draft' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == 'draft'
      );
      allow delete: if isAdmin();
    }

    match /portfolios/{portfolioId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() &&
        isOwner(request.resource.data.userId) &&
        isValidPortfolio(request.resource.data) &&
        request.resource.data.validationStatus == 'pending';
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.validationStatus == resource.data.validationStatus
      );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Vehicle agreements are private to the two named participants.
    // Ownership and custody remain separate concepts; acknowledgements can only
    // be recorded by the corresponding participant and are immutable afterward.
    match /vehicleAgreements/{agreementId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantUids;

      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.custodianId is string &&
        request.resource.data.custodianId != request.auth.uid &&
        request.resource.data.participantUids is list &&
        request.resource.data.participantUids.size() == 2 &&
        request.resource.data.participantUids.hasAll([
          request.auth.uid, request.resource.data.custodianId
        ]) &&
        request.resource.data.vehicleId is string &&
        request.resource.data.vehicleLabel is string &&
        request.resource.data.registrationNumber is string &&
        request.resource.data.agreementType in ['loan', 'repair', 'custody'] &&
        request.resource.data.startDate is string &&
        request.resource.data.expectedReturnDate is string &&
        request.resource.data.terms is string &&
        request.resource.data.terms.size() > 0 &&
        request.resource.data.terms.size() <= 4000 &&
        request.resource.data.ownerAcceptedAt == null &&
        request.resource.data.custodianAcceptedAt == null;

      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.ownerId &&
          resource.data.ownerAcceptedAt == null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerAcceptedAt', 'updatedAt']) &&
          request.resource.data.ownerAcceptedAt is timestamp &&
          request.resource.data.updatedAt is timestamp
        ) ||
        (
          request.auth.uid == resource.data.custodianId &&
          resource.data.custodianAcceptedAt == null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['custodianAcceptedAt', 'updatedAt']) &&
          request.resource.data.custodianAcceptedAt is timestamp &&
          request.resource.data.updatedAt is timestamp
        )
      );

      // Preserve the agreement history; administrative cleanup only.
      allow delete: if isAdmin();
    }

    match /regionalStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny for collections without an explicit rule above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
